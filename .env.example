# ── App ───────────────────────────────────────────────────────────────────────
APP_NAME="ECOT AI Backend"
APP_VERSION="1.0.0"
DEBUG=false

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# For Docker Compose: host = "db" (service name). For local: host = "localhost"
DATABASE_URL=postgresql://ecot:ecot_pass@localhost:5432/ecot_db

# ── Firebase ──────────────────────────────────────────────────────────────────
# Path to your downloaded Firebase service account JSON key
FIREBASE_CREDENTIALS_PATH=firebase_credentials.json

# Your Realtime Database URL (from Firebase console -> Realtime Database)
FIREBASE_DATABASE_URL=https://YOUR-PROJECT-ID-default-rtdb.firebaseio.com

# Root node to watch. "/" means all users. Can also be a single user key.
FIREBASE_ROOT_NODE=/

# ── Polling ───────────────────────────────────────────────────────────────────
POLLING_INTERVAL_SECONDS=5        # How often to read Firebase
DATA_RETENTION_HOURS=3            # How long raw_readings are kept
CLEANUP_INTERVAL_SECONDS=300      # How often cleanup job runs (5 min)
BASELINE_UPDATE_INTERVAL_SECONDS=3600  # How often baselines are rebuilt (1 hr)

# ── ML ────────────────────────────────────────────────────────────────────────
MODEL_DIR=models                  # Directory for saved joblib model files
ANOMALY_CONTAMINATION=0.05        # Expected fraction of outliers (Isolation Forest)
ANOMALY_THRESHOLD=0.5             # Score above this triggers anomaly flag
MIN_TRAINING_SAMPLES=50           # Raw readings needed before auto-training fires

# ── Rule-based Thresholds ─────────────────────────────────────────────────────
VOLTAGE_MIN=180.0                 # Minimum acceptable voltage (V)
VOLTAGE_MAX=260.0                 # Maximum acceptable voltage (V)
CURRENT_MAX=30.0                  # Maximum acceptable current (A)
POWER_MAX=5000.0                  # Maximum acceptable power (W)
POWER_SPIKE_MULTIPLIER=3.0        # Power spike = N × rolling avg

# ── Forecasting ───────────────────────────────────────────────────────────────
FORECAST_UPDATE_INTERVAL_SECONDS=3600   # How often 24h forecasts are regenerated (1 hr)
MIN_FORECAST_SAMPLES=48                 # Hourly summaries needed to use ML forecast
                                        # (falls back to baseline averages below this)

# ── Tariff – NEPRA Pakistan Residential ──────────────────────────────────────
TARIFF_PEAK_START_HOUR=17        # 5:00 PM PKT  (peak start)
TARIFF_PEAK_END_HOUR=5           # 5:00 AM PKT  (peak end, wraps midnight)
TARIFF_CURRENCY=Rs

# Sanctioned load determines the tariff schedule:
#   < 5 kW  → Slab-based tariff (rate depends on monthly units consumed)
#   >= 5 kW → TOU: Peak Rs 46.85 / Off-peak Rs 34.53
SANCTIONED_LOAD_KW=5.0

# Set true for protected/lifeline consumers (≤50 units/month, very low income)
TARIFF_PROTECTED=false

# TOU rates (applies when SANCTIONED_LOAD_KW >= 5.0)
TARIFF_PEAK_RATE=46.85           # Rs / kWh  (5 PM – 5 AM PKT)
TARIFF_OFF_PEAK_RATE=34.53       # Rs / kWh  (5 AM – 5 PM PKT)
